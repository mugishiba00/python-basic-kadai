        "\n",
        "\n",
        "   self.name = name\n",
        "\n",
        "   self.age = age\n",
        "\n",
        "  def printinfo (self):\n",
        "\n",
        "    print(self.name)\n",
        "\n",
        "    print(self.age)\n",
        "\n",
        "human = Human (\"ichiro\",30)\n",
        "human.printinfo()\n"
